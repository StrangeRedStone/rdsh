# rdsh 配置文件示例
# 复制到 ~/.config/rdsh/config 后按需修改。
#
# 规则：
#   * 纯 KEY=VALUE；**不会被 source**，只是取值。
#   * 优先级：环境变量 > 本文件 > 默认值。
#   * 值可以写 ~（会展开成 $HOME）。
#   * 改路径用 `rdsh base <路径>` 更省事（本文件同款写入）。

# ── 单一旋钮 ───────────────────────────────────────────────
# 决定下面所有默认值的根。默认 $HOME/Mapp。
BASE=~/Mapp

# ── 逐项覆盖（按需取消注释） ───────────────────────────────
# MANAGE_ROOT=~/Mapp/dsh          # 检出根（本仓库应在这，与检出同目录）
# DATA_ROOT=~/Mapp/.dsh           # 每版本数据根
# BACKUP_ROOT=~/Mapp/.dsh-backup  # 备份与回退基线（回退基线.md 是生成物）
# SHARED_ROOT=~/Mapp/.dsh-shared  # 与版本无关的作者资产（软链共享）
# LOG_DIR=~/Mapp/.dsh-logs        # 启动日志（含访问 token，注意权限）
# STATE_ROOT=~/Mapp/.dsh-suite/state  # 状态账本（唯一权威）：versions.kv + journal.log
# RUN_DIR=~/Mapp/.dsh-suite/run       # 实例注册表（注解层，真相是 ss + /proc）
# DEBUG_ROOT=~/Mapp/.dsh-suite/debug  # 调试沙箱（rdsh debug）

# ── 其它 ───────────────────────────────────────────────────
# TRASH_ROOT=~/Mapp/.dsh-suite/trash  # 回收站根（默认同 BASE 的文件系统；跨设备会慢）
# RDSH_TRASH_KEEP_DAYS=7          # 回收项小于这个天数时，du --purge trash 要 --force
# RDSH_REMOTE=https://github.com/deepseek-ai/deepseek-harness.git
# RDSH_TAG_PREFIX=dsh-v           # 远端 tag 命名：dsh-v<版本>
# RDSH_AUTO_INSTALL=1             # 启动时缺依赖自动 pnpm install
# RDSH_SCAN=~/Mapp/dsh/scan-secrets.sh  # 隐私守卫位置（「我的 dsh」backup.sh --commit 用它）
# RDSH_MYDSH_REPO=~/workspace/my-dsh  # 「我的 dsh」本地克隆；rdsh restore 不写 --from 时用它
# PATCHES=~/Mapp/.dsh-suite/patches   # 补丁仓（与 patch-manager.sh 同默认）
# PLUGIN_ROOT=~/Mapp/.dsh-suite/plugins  # 插件权威副本
